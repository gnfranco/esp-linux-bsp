# ESP32-S31 Function-CoreBoard-1: experimental peripheral bring-up.
CONFIG_RESET_ESP32S31=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_DEBUG_FS=y
CONFIG_CAN=y
CONFIG_CAN_RAW=y
CONFIG_CAN_VCAN=y

# Experimental RMT LED driver (apply Linux patch first).
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_LEDS_ESP32S31_RMT=y

# RMT v1.1 generic TX controller (apply both Linux patches in order).
CONFIG_ESP32S31_RMT=y
