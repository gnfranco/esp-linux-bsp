From a8fe3e328154415b04a6960171add04347034c25 Mon Sep 17 00:00:00 2001
From: Glauber Franco <gnfranco@gmail.com>
Date: Wed, 25 Nov 2026 00:41:35 -0300
Subject: [PATCH 7/7] soc: espressif: harden RMT timeout and channel teardown

Serialize timeout completion with the IRQ handler and ensure reset is
asserted on resource release. Quiesce channel users before relinquishing
exclusive ownership.

Developed with assistance from ChatGPT (OpenAI).

Signed-off-by: Glauber Franco <gnfranco@gmail.com>
---
 drivers/soc/esp32s31-rmt.c        | 25 ++++++++++++++++++++-----
 include/linux/soc/espressif/rmt.h |  1 +
 2 files changed, 21 insertions(+), 5 deletions(-)

diff --git a/drivers/soc/esp32s31-rmt.c b/drivers/soc/esp32s31-rmt.c
index 3c4dba73d..bea698f79 100644
--- a/drivers/soc/esp32s31-rmt.c
+++ b/drivers/soc/esp32s31-rmt.c
@@ -102,9 +102,12 @@ static void esp_rmt_release(void *data)
 {
 	struct esp_rmt_channel *ch = data;
 
+	/* The client must stop initiating TX before releasing the channel. */
+	mutex_lock(&ch->tx_lock);
 	mutex_lock(&ch->rmt->claim_lock);
 	ch->claimed = false;
 	mutex_unlock(&ch->rmt->claim_lock);
+	mutex_unlock(&ch->tx_lock);
 }
 
 struct esp_rmt_channel *devm_esp_rmt_tx_get(struct device *dev, u32 channel)
@@ -179,11 +182,10 @@ int esp_rmt_tx(struct esp_rmt_channel *ch, unsigned long tick_hz,
 	writel(conf | RMT_UPDATE, base + RMT_CONF(id));
 	writel(conf | RMT_TX_START, base + RMT_CONF(id));
 	spin_unlock_irqrestore(&rmt->irq_lock, flags);
-	if (!wait_for_completion_timeout(&ch->done, timeout))
-		ret = -ETIMEDOUT;
-	else
-		ret = ch->result;
+	wait_for_completion_timeout(&ch->done, timeout);
 	spin_lock_irqsave(&rmt->irq_lock, flags);
+	/* Serialize with an IRQ arriving at the timeout boundary. */
+	ret = ch->active ? -ETIMEDOUT : ch->result;
 	ch->active = false;
 	writel(readl(base + RMT_INT_EN) & ~mask, base + RMT_INT_EN);
 	if (ret) {
@@ -206,6 +208,13 @@ static void esp_rmt_restore(void *data)
 	regmap_update_bits(rmt->hp, RMT_MEM_LP, RMT_LP_MASK, rmt->old_lp);
 }
 
+static void esp_rmt_assert_reset(void *data)
+{
+	struct reset_control *rst = data;
+
+	reset_control_assert(rst);
+}
+
 static int esp_rmt_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -244,6 +253,9 @@ static int esp_rmt_probe(struct platform_device *pdev)
 		return ret;
 	udelay(2);
 	ret = reset_control_deassert(rst);
+	if (ret)
+		return ret;
+	ret = devm_add_action_or_reset(dev, esp_rmt_assert_reset, rst);
 	if (ret)
 		return ret;
 	rmt->hp = syscon_regmap_lookup_by_phandle(dev->of_node, "esp,hp-system");
@@ -270,8 +282,11 @@ static int esp_rmt_probe(struct platform_device *pdev)
 		return dev_err_probe(dev, ret, "RMT IRQ\n");
 	platform_set_drvdata(pdev, rmt);
 	ret = devm_of_platform_populate(dev);
-	if (ret)
+	if (ret) {
+		of_platform_depopulate(dev);
+		platform_set_drvdata(pdev, NULL);
 		return ret;
+	}
 	dev_info(dev, "RMT TX: %u channels, IRQ %d, clock %lu Hz\n",
 		 RMT_CHANNELS, rmt->irq, clk_get_rate(rmt->clk));
 	return 0;
diff --git a/include/linux/soc/espressif/rmt.h b/include/linux/soc/espressif/rmt.h
index c1b9c1867..855538789 100644
--- a/include/linux/soc/espressif/rmt.h
+++ b/include/linux/soc/espressif/rmt.h
@@ -11,6 +11,7 @@ struct esp_rmt_channel;
 #define ESP_RMT_TX_MAX_SYMBOLS 47
 
 struct esp_rmt_channel *devm_esp_rmt_tx_get(struct device *dev, u32 channel);
+/* Sleepable synchronous TX. Consumers must quiesce before devres release. */
 int esp_rmt_tx(struct esp_rmt_channel *chan, unsigned long tick_hz,
 	       const u32 *symbols, size_t count);
 
