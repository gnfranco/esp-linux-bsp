diff --git a/Documentation/devicetree/bindings/leds/esp,esp32s31-rmt-ws2812.yaml b/Documentation/devicetree/bindings/leds/esp,esp32s31-rmt-ws2812.yaml
new file mode 100644
index 000000000..059246713
--- /dev/null
+++ b/Documentation/devicetree/bindings/leds/esp,esp32s31-rmt-ws2812.yaml
@@ -0,0 +1,35 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/leds/esp,esp32s31-rmt-ws2812.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Single WS2812 RGB LED on ESP32-S31 RMT
+
+maintainers:
+  - Glauber Franco <776952+gnfranco@users.noreply.github.com>
+
+description: |
+  An addressable RGB LED using one exclusive RMT TX channel. The pinctrl
+  state routes the selected channel's output to the board's data pin.
+
+properties:
+  compatible:
+    const: esp,esp32s31-rmt-ws2812
+  reg:
+    items:
+      - minimum: 0
+        maximum: 3
+  pinctrl-names:
+    items:
+      - const: default
+  pinctrl-0: true
+
+required:
+  - compatible
+  - reg
+  - pinctrl-names
+  - pinctrl-0
+
+additionalProperties: false
+...
diff --git a/Documentation/devicetree/bindings/soc/espressif/esp,esp32s31-rmt.yaml b/Documentation/devicetree/bindings/soc/espressif/esp,esp32s31-rmt.yaml
new file mode 100644
index 000000000..9c45f57d5
--- /dev/null
+++ b/Documentation/devicetree/bindings/soc/espressif/esp,esp32s31-rmt.yaml
@@ -0,0 +1,58 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/soc/espressif/esp,esp32s31-rmt.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Espressif ESP32-S31 RMT transmit controller
+
+maintainers:
+  - Glauber Franco <776952+gnfranco@users.noreply.github.com>
+
+description: |
+  The RMT controller generates timed digital symbols. This experimental
+  binding exposes four transmit channels with one 48-word block per channel.
+  Each child consumes one channel, specified by its reg property.
+
+properties:
+  compatible:
+    const: esp,esp32s31-rmt
+  reg:
+    maxItems: 1
+  interrupts:
+    maxItems: 1
+  clocks:
+    items:
+      - description: APB interface clock
+      - description: RMT symbol clock
+  clock-names:
+    items:
+      - const: apb
+      - const: rmt
+  resets:
+    maxItems: 1
+  esp,hp-system:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: HP system syscon controlling RMT memory power
+  '#address-cells':
+    const: 1
+  '#size-cells':
+    const: 0
+
+patternProperties:
+  '^led@[0-3]$':
+    $ref: /schemas/leds/esp,esp32s31-rmt-ws2812.yaml#
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - clocks
+  - clock-names
+  - resets
+  - esp,hp-system
+  - '#address-cells'
+  - '#size-cells'
+
+additionalProperties: false
+...
diff --git a/arch/riscv/boot/dts/espressif/esp32s31-function-core-board-1.dts b/arch/riscv/boot/dts/espressif/esp32s31-function-core-board-1.dts
index 9c8f4e7ab..92117157e 100644
--- a/arch/riscv/boot/dts/espressif/esp32s31-function-core-board-1.dts
+++ b/arch/riscv/boot/dts/espressif/esp32s31-function-core-board-1.dts
@@ -132,7 +132,12 @@ &usb {
 };
 
 &rmt {
-	pinctrl-names = "default";
-	pinctrl-0 = <&rgb_pins>;
 	status = "okay";
+
+	led@0 {
+		compatible = "esp,esp32s31-rmt-ws2812";
+		reg = <0>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&rgb_pins>;
+	};
 };
diff --git a/arch/riscv/boot/dts/espressif/esp32s31.dtsi b/arch/riscv/boot/dts/espressif/esp32s31.dtsi
index c7c51b9c9..8acea95de 100644
--- a/arch/riscv/boot/dts/espressif/esp32s31.dtsi
+++ b/arch/riscv/boot/dts/espressif/esp32s31.dtsi
@@ -209,12 +209,18 @@ hp_sys: syscon@20586000 {
 			reg = <0x20586000 0x400>;
 		};
 
-		rmt: led-controller@20355000 {
-			compatible = "esp,esp32s31-rmt-ws2812";
+		rmt: rmt@20355000 {
+			compatible = "esp,esp32s31-rmt";
 			reg = <0x20355000 0x1000>;
-			esp,clkrst = <&sysctl>;
 			esp,hp-system = <&hp_sys>;
-			clocks = <&xtal_clk>;
+			clocks = <&clk ESP_S31_CLK_RMT_APB>,
+				 <&clk ESP_S31_CLK_RMT>;
+			clock-names = "apb", "rmt";
+			resets = <&rst ESP_S31_RST_RMT>;
+			interrupt-parent = <&intmtx>;
+			interrupts = <22 IRQ_TYPE_LEVEL_HIGH>;
+			#address-cells = <1>;
+			#size-cells = <0>;
 			status = "disabled";
 		};
 
diff --git a/drivers/clk/clk-esp32s31.c b/drivers/clk/clk-esp32s31.c
index a6d4e3b33..0e4187d6e 100644
--- a/drivers/clk/clk-esp32s31.c
+++ b/drivers/clk/clk-esp32s31.c
@@ -21,6 +21,7 @@
 #include <dt-bindings/clock/esp32s31.h>
 
 /* Peripheral control registers in HP_SYS_CLKRST */
+#define ESP32S31_HP_CLKRST_RMT_CTRL0	0x0bc
 #define ESP32S31_HP_CLKRST_EMAC_CTRL0	0x0c8
 #define ESP32S31_HP_CLKRST_I2C0_CTRL0	0x0dc
 #define ESP32S31_HP_CLKRST_I2C1_CTRL0	0x0e0
@@ -117,6 +118,7 @@ struct esp_clk_desc {
 	u8 map_idx;
 	u32 reg;
 	u32 gate;
+	u32 prepare_clear;
 	u32 div;
 	u32 frac;
 	u32 mux;
@@ -280,7 +282,8 @@ static int esp_clk_prepare(struct clk_hw *hw)
 	struct esp_clk *esp_clk = to_esp_clk(hw);
 
 	return regmap_update_bits(esp_clk->map, esp_clk->desc->reg,
-				  esp_clk->desc->gate, esp_clk->desc->gate);
+				  esp_clk->desc->gate | esp_clk->desc->prepare_clear,
+				  esp_clk->desc->gate);
 }
 
 static void esp_clk_unprepare(struct clk_hw *hw)
@@ -423,6 +426,8 @@ static const u16 esp32s31_i2c_parent_ids[] = {
 	ESP_S31_CLK_RC_FAST,
 };
 
+static const char * const esp32s31_rmt_parents[] = { "xtal" };
+
 static const struct esp_clk_desc esp32s31_clk_descs[] = {
 	[ESP_S31_CLK_IOMUX_APB] = {
 		.name = "iomux_apb",
@@ -539,6 +544,22 @@ static const struct esp_clk_desc esp32s31_clk_descs[] = {
 		.parent_ids = esp32s31_apb_parent_ids,
 		.num_parents = ARRAY_SIZE(esp32s31_apb_parent_ids),
 	},
+	[ESP_S31_CLK_RMT_APB] = {
+		.name = "rmt_apb",
+		.reg = ESP32S31_HP_CLKRST_RMT_CTRL0,
+		.gate = BIT(0),
+		.parent_ids = esp32s31_apb_parent_ids,
+		.num_parents = ARRAY_SIZE(esp32s31_apb_parent_ids),
+	},
+	[ESP_S31_CLK_RMT] = {
+		.name = "rmt",
+		.reg = ESP32S31_HP_CLKRST_RMT_CTRL0,
+		.gate = BIT(5),
+		/* Model only XTAL / 1 until other sources are validated. */
+		.prepare_clear = GENMASK(4, 3) | GENMASK(29, 6),
+		.parents = esp32s31_rmt_parents,
+		.num_parents = ARRAY_SIZE(esp32s31_rmt_parents),
+	},
 };
 
 static const struct clk_ops *esp_clk_pick_ops(const struct esp_clk_desc *desc)
@@ -736,6 +757,9 @@ static int esp_clk_probe(struct platform_device *pdev)
 		struct clk_init_data init = { };
 		struct esp_clk *esp_clk;
 
+		if (!desc->name)
+			continue;
+
 		esp_clk = devm_kzalloc(dev, sizeof(*esp_clk), GFP_KERNEL);
 		if (!esp_clk)
 			return -ENOMEM;
