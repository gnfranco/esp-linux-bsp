 drivers/leds/rgb/Kconfig                      |   2 +-
 drivers/leds/rgb/leds-esp32s31-rmt.c          | 197 +++++--------
 drivers/pinctrl/espressif/pinctrl-esp32s31.c  |   3 +
 drivers/reset/reset-esp32s31.c                |   5 +
 drivers/soc/Kconfig                           |   6 +
 drivers/soc/Makefile                          |   2 +
 drivers/soc/esp32s31-rmt.c                    | 275 ++++++++++++++++++
