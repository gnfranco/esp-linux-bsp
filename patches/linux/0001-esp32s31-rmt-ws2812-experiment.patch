diff --git a/arch/riscv/boot/dts/espressif/esp32s31-function-core-board-1.dts b/arch/riscv/boot/dts/espressif/esp32s31-function-core-board-1.dts
index 9d355e5dd..9c8f4e7ab 100644
--- a/arch/riscv/boot/dts/espressif/esp32s31-function-core-board-1.dts
+++ b/arch/riscv/boot/dts/espressif/esp32s31-function-core-board-1.dts
@@ -25,6 +25,12 @@ aliases {
 };
 
 &espfunc {
+	rgb_pins: rgb-pins {
+		pinmux = <ESP_PINMUX(60, ESP_FUNC_S31_RMT_TX0_ID)>;
+		bias-disable;
+		drive-strength = <10>;
+	};
+
 	/* I2C0: SDA on GPIO51 and SCL on GPIO50. */
 	i2c0_pins: i2c0-pins {
 		pinmux = <ESP_PINMUX(51, ESP_FUNC_S31_I2C0_SDA_ID)>,
@@ -124,3 +130,9 @@ phy0: ethernet-phy@0 {
 &usb {
 	status = "okay";
 };
+
+&rmt {
+	pinctrl-names = "default";
+	pinctrl-0 = <&rgb_pins>;
+	status = "okay";
+};
diff --git a/arch/riscv/boot/dts/espressif/esp32s31.dtsi b/arch/riscv/boot/dts/espressif/esp32s31.dtsi
index 563118ab8..c7c51b9c9 100644
--- a/arch/riscv/boot/dts/espressif/esp32s31.dtsi
+++ b/arch/riscv/boot/dts/espressif/esp32s31.dtsi
@@ -204,6 +204,20 @@ sdmmc: mmc@20342000 {
 			status = "disabled";
 		};
 
+		hp_sys: syscon@20586000 {
+			compatible = "esp,esp32s31-hp-system", "syscon";
+			reg = <0x20586000 0x400>;
+		};
+
+		rmt: led-controller@20355000 {
+			compatible = "esp,esp32s31-rmt-ws2812";
+			reg = <0x20355000 0x1000>;
+			esp,clkrst = <&sysctl>;
+			esp,hp-system = <&hp_sys>;
+			clocks = <&xtal_clk>;
+			status = "disabled";
+		};
+
 		/*
 		 * HP_SYS_CLKRST. Peripheral clock gates and resets that sit
 		 * outside the peripherals' own register windows.
