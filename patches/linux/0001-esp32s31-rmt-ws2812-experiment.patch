--- a/drivers/pinctrl/espressif/pinctrl-esp32s31.c
+++ b/drivers/pinctrl/espressif/pinctrl-esp32s31.c
@@ -242,6 +242,7 @@ static const struct esp_pin_function esp32s31_functions[] = {
 	[ESP_FUNC_S31_SDMMC_ID] = { ESP_FUNC_NONE, ESP_FUNC_NONE,
 				    ESP_FUNC_NONE,
 				    ESP_OWNER(S31_OWNER_CNNT_SDIO) },
+	[ESP_FUNC_S31_RMT_TX0_ID] = { GPIO_FUNC_GPIO, ESP_FUNC_NONE, RMT_SIG_OUT0_IDX },
 };
 
 static int esp_s31_matrix_set_in(struct esp_pinctrl *epctl, u32 gpio, u32 signal)
diff --git a/include/dt-bindings/pinctrl/esp32s31-iomux.h b/include/dt-bindings/pinctrl/esp32s31-iomux.h
index b61d97b7f..d73bd491f 100644
--- a/include/dt-bindings/pinctrl/esp32s31-iomux.h
+++ b/include/dt-bindings/pinctrl/esp32s31-iomux.h
@@ -594,4 +594,6 @@
 /* SDMMC slot 0 reaches GPIO20-25 through the CNNT dedicated pad path. */
 #define ESP_FUNC_S31_SDMMC_ID				39
 
+#define ESP_FUNC_S31_RMT_TX0_ID			40
