From 38e1721c91e7759a0902991fdf07b922157cb01b Mon Sep 17 00:00:00 2001
From: Glauber Franco <gnfranco@gmail.com>
Date: Wed, 25 Nov 2026 00:25:27 -0300
Subject: [PATCH 1/7] dt-bindings: describe ESP32-S31 RMT TX and WS2812 LED

Describe controller resources and append clock, reset and pinmux IDs.

Developed with assistance from ChatGPT (OpenAI).

Signed-off-by: Glauber Franco <gnfranco@gmail.com>
---
 .../leds/esp,esp32s31-rmt-ws2812.yaml         | 35 +++++++++++
 .../soc/espressif/esp,esp32s31-rmt.yaml       | 58 +++++++++++++++++++
 include/dt-bindings/clock/esp32s31.h          |  4 +-
 include/dt-bindings/pinctrl/esp32s31-iomux.h  |  5 ++
 include/dt-bindings/reset/esp32s31.h          |  3 +-
 5 files changed, 103 insertions(+), 2 deletions(-)
 create mode 100644 Documentation/devicetree/bindings/leds/esp,esp32s31-rmt-ws2812.yaml
 create mode 100644 Documentation/devicetree/bindings/soc/espressif/esp,esp32s31-rmt.yaml

diff --git a/Documentation/devicetree/bindings/leds/esp,esp32s31-rmt-ws2812.yaml b/Documentation/devicetree/bindings/leds/esp,esp32s31-rmt-ws2812.yaml
new file mode 100644
index 000000000..149d89c58
--- /dev/null
+++ b/Documentation/devicetree/bindings/leds/esp,esp32s31-rmt-ws2812.yaml
@@ -0,0 +1,35 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/leds/esp,esp32s31-rmt-ws2812.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Single WS2812 RGB LED on ESP32-S31 RMT
+
+maintainers:
+  - Glauber Franco <gnfranco@gmail.com>
+
+description: |
+  An addressable RGB LED using one exclusive RMT TX channel. The pinctrl
+  state routes the selected channel's output to the board's data pin.
+
+properties:
+  compatible:
+    const: esp,esp32s31-rmt-ws2812
+  reg:
+    items:
+      - minimum: 0
+        maximum: 3
+  pinctrl-names:
+    items:
+      - const: default
+  pinctrl-0: true
+
+required:
+  - compatible
+  - reg
+  - pinctrl-names
+  - pinctrl-0
+
+additionalProperties: false
+...
diff --git a/Documentation/devicetree/bindings/soc/espressif/esp,esp32s31-rmt.yaml b/Documentation/devicetree/bindings/soc/espressif/esp,esp32s31-rmt.yaml
new file mode 100644
index 000000000..1ceb6e571
--- /dev/null
+++ b/Documentation/devicetree/bindings/soc/espressif/esp,esp32s31-rmt.yaml
@@ -0,0 +1,58 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/soc/espressif/esp,esp32s31-rmt.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Espressif ESP32-S31 RMT transmit controller
+
+maintainers:
+  - Glauber Franco <gnfranco@gmail.com>
+
+description: |
+  The RMT controller generates timed digital symbols. This experimental
+  binding exposes four transmit channels with one 48-word block per channel.
+  Each child consumes one channel, specified by its reg property.
+
+properties:
+  compatible:
+    const: esp,esp32s31-rmt
+  reg:
+    maxItems: 1
+  interrupts:
+    maxItems: 1
+  clocks:
+    items:
+      - description: APB interface clock
+      - description: RMT symbol clock
+  clock-names:
+    items:
+      - const: apb
+      - const: rmt
+  resets:
+    maxItems: 1
+  esp,hp-system:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: HP system syscon controlling RMT memory power
+  '#address-cells':
+    const: 1
+  '#size-cells':
+    const: 0
+
+patternProperties:
+  '^led@[0-3]$':
+    $ref: /schemas/leds/esp,esp32s31-rmt-ws2812.yaml#
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - clocks
+  - clock-names
+  - resets
+  - esp,hp-system
+  - '#address-cells'
+  - '#size-cells'
+
+additionalProperties: false
+...
diff --git a/include/dt-bindings/clock/esp32s31.h b/include/dt-bindings/clock/esp32s31.h
index 13f730e30..2009a2d43 100644
--- a/include/dt-bindings/clock/esp32s31.h
+++ b/include/dt-bindings/clock/esp32s31.h
@@ -55,6 +55,8 @@
 /* High-performance APB clock derived from the system clock */
 #define ESP_S31_CLK_APB		21
 
-#define ESP_S31_CLK_NUM		22
+#define ESP_S31_CLK_RMT_APB	22
+#define ESP_S31_CLK_RMT		23
+#define ESP_S31_CLK_NUM		24
 
 #endif /* ESP32S31_CLOCK_H */
diff --git a/include/dt-bindings/pinctrl/esp32s31-iomux.h b/include/dt-bindings/pinctrl/esp32s31-iomux.h
index b61d97b7f..2e066dc9a 100644
--- a/include/dt-bindings/pinctrl/esp32s31-iomux.h
+++ b/include/dt-bindings/pinctrl/esp32s31-iomux.h
@@ -594,4 +594,9 @@
 /* SDMMC slot 0 reaches GPIO20-25 through the CNNT dedicated pad path. */
 #define ESP_FUNC_S31_SDMMC_ID				39
 
+#define ESP_FUNC_S31_RMT_TX0_ID			40
+#define ESP_FUNC_S31_RMT_TX1_ID			41
+#define ESP_FUNC_S31_RMT_TX2_ID			42
+#define ESP_FUNC_S31_RMT_TX3_ID			43
+
 #endif /* ESP32S31_IOMUX_H */
diff --git a/include/dt-bindings/reset/esp32s31.h b/include/dt-bindings/reset/esp32s31.h
index b81d9519d..f3bea0141 100644
--- a/include/dt-bindings/reset/esp32s31.h
+++ b/include/dt-bindings/reset/esp32s31.h
@@ -27,6 +27,7 @@
 /* SDMMC controller reset (CNNT_SYS HP_SDMMC_CTRL) */
 #define ESP_S31_RST_SDMMC	7
 
-#define ESP_S31_RST_NUM		8
+#define ESP_S31_RST_RMT		8
+#define ESP_S31_RST_NUM		9
 
 #endif /* ESP32S31_RESET_H */
