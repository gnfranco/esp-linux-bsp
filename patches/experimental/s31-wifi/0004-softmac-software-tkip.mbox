From 36188eda651c81a4400742ac589c5985ee51bd04 Mon Sep 17 00:00:00 2001
From: Glauber Franco <gnfranco@gmail.com>
Date: Wed, 25 Nov 2026 18:21:56 -0300
Subject: [PATCH 1/2] wifi: experimental software TKIP and CCMP profile

Opt-in module parameter; no native crypto offload. Hardware advertises both ciphers; legacy-only association rejected with status 18. Developed with assistance from ChatGPT.

Signed-off-by: Glauber Franco <gnfranco@gmail.com>
---
 .../net/wireless/espressif/esp32s31_softmac.c | 41 +++++++++++++++----
 1 file changed, 32 insertions(+), 9 deletions(-)

diff --git a/drivers/net/wireless/espressif/esp32s31_softmac.c b/drivers/net/wireless/espressif/esp32s31_softmac.c
index 76109dc5a..678ef38d3 100644
--- a/drivers/net/wireless/espressif/esp32s31_softmac.c
+++ b/drivers/net/wireless/espressif/esp32s31_softmac.c
@@ -69,6 +69,12 @@ static const bool sm_he_tx = true;
 
 static const bool sm_rx_ba = true;
 
+/* Experimental legacy interoperability: keep every key in mac80211.
+ * Read-only parameter so crypto ownership cannot change while running. */
+static bool sm_legacy_tkip;
+module_param_named(legacy_tkip, sm_legacy_tkip, bool, 0400);
+MODULE_PARM_DESC(legacy_tkip, "experimental TKIP/CCMP software crypto, legacy rates only");
+
 static const bool sm_hw_ccmp = true;
 
 static const bool sm_hw_tx_ccmp = true;
@@ -1478,7 +1484,7 @@ static int sm_start(struct ieee80211_hw *hw)
 	memcpy(ctl.mac, hw->wiphy->perm_addr, ETH_ALEN);
 	ctl.channel = sm->channel ?: 1;
 	ctl.offset = ++sm->epoch;
-	ctl.field = (sm_ht ? 1 : 0) | (sm_ht && sm_he ? 2 : 0) |
+	ctl.field = (!sm_legacy_tkip && sm_ht ? 1 : 0) | (!sm_legacy_tkip && sm_ht && sm_he ? 2 : 0) |
 		(sm_rx_view ? S31_SOFTMAC_START_RX_VIEW : 0) |
 		(sm_rx_filter && sm_native_rx_filter ? S31_SOFTMAC_START_RX_RA_FILTER : 0) |
   (sm_native_rx_error_filter ? S31_SOFTMAC_START_RX_DROP_ERRORS : 0) |
@@ -1864,14 +1870,14 @@ static void sm_bss_changed(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
                                 READ_ONCE(sm->running));
  if ((changed & BSS_CHANGED_ASSOC) && !vif->cfg.assoc)
   flush_work(&sm->filter_io);
- if ((sm_hw_ccmp || sm_hw_tx_ccmp) && (changed & BSS_CHANGED_ASSOC) && !vif->cfg.assoc && READ_ONCE(sm->running)) {
+ if (!sm_legacy_tkip && (sm_hw_ccmp || sm_hw_tx_ccmp) && (changed & BSS_CHANGED_ASSOC) && !vif->cfg.assoc && READ_ONCE(sm->running)) {
   struct s31_wifi_control ctl = { .operation = S31_WIFI_SOFTMAC_RX_KEY_DEL, .length = 16 };
   /* Software TX keys do not receive DISABLE_KEY callbacks. Disassociation
    * therefore explicitly retires all RX-only hardware slots. */
   for (ctl.field = 0; ctl.field < 5; ctl.field++)
    if (esp32s31_radio_wifi_control(&ctl)) pr_warn("esp32s31-softmac: RX key retirement failed\n");
  }
- if (sm_he && READ_ONCE(sm->running) &&
+ if (!sm_legacy_tkip && sm_he && READ_ONCE(sm->running) &&
      (changed & (BSS_CHANGED_ASSOC | BSS_CHANGED_BSSID | BSS_CHANGED_HE_BSS_COLOR))) {
   struct s31_wifi_control ctl = { .operation = S31_WIFI_SOFTMAC_HE_BSS };
   ctl.length = vif->cfg.assoc && info->he_support;
@@ -2090,7 +2096,7 @@ static int sm_sta_add(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
                       struct ieee80211_sta *sta)
 {
  struct s31_sm *sm = hw->priv;
- WRITE_ONCE(sm->tx_ht_peer, sm_data_tx_mcs >= 0 &&
+ WRITE_ONCE(sm->tx_ht_peer, !sm_legacy_tkip && sm_data_tx_mcs >= 0 &&
             sta->deflink.ht_cap.ht_supported &&
             (sta->deflink.ht_cap.mcs.rx_mask[0] & BIT(min(sm_data_tx_mcs, 7))));
  WRITE_ONCE(sm->tx_he_peer, sm_he_tx && sm->tx_ht_peer &&
@@ -2185,6 +2191,16 @@ static int sm_key(struct ieee80211_hw *hw, enum set_key_cmd cmd,
 	bool tx_offload = sm_hw_tx_ccmp && pairwise;
 	u8 token = 0;
 	int ret;
+	if (sm_legacy_tkip) {
+		if (key->cipher != WLAN_CIPHER_SUITE_TKIP &&
+		    key->cipher != WLAN_CIPHER_SUITE_CCMP)
+			return -EOPNOTSUPP;
+		if (key->keyidx > 3 || (pairwise && !sta) ||
+		    key->keylen != (key->cipher == WLAN_CIPHER_SUITE_TKIP ? 32 : 16))
+			return -EINVAL;
+		/* No key slots programmed; explicitly allow mac80211 software crypto. */
+		return cmd == DISABLE_KEY ? 0 : 1;
+	}
 	if (key->cipher != WLAN_CIPHER_SUITE_CCMP)
 		return -EOPNOTSUPP;
 	/* Reusing a token while old plaintext may still be queued is unsafe.
@@ -2402,7 +2418,7 @@ int s31_radio_wifi_frontend_init(struct device *parent)
 	sm->band.n_channels = ARRAY_SIZE(sm->channels);
 	sm->band.bitrates = sm->rates;
 	sm->band.n_bitrates = ARRAY_SIZE(sm->rates);
-	{
+	if (!sm_legacy_tkip) {
 		sm->band.ht_cap.ht_supported = true;
 		sm->band.ht_cap.cap = IEEE80211_HT_CAP_SGI_20;
 		sm->band.ht_cap.ampdu_factor = IEEE80211_HT_MAX_AMPDU_64K;
@@ -2427,7 +2443,7 @@ int s31_radio_wifi_frontend_init(struct device *parent)
 			}
 		}
 	}
-	{
+	if (!sm_legacy_tkip) {
 		sm->iftype.types_mask = BIT(NL80211_IFTYPE_STATION);
 		sm->iftype.he_cap.has_he = true;
 		sm->iftype.he_cap.he_cap_elem.phy_cap_info[1] =
@@ -2459,7 +2475,7 @@ int s31_radio_wifi_frontend_init(struct device *parent)
 	hw->max_rate_tries = 1;
 	/* mac80211 fast TX requires disabled fragmentation, not the largest
 	 * finite threshold. Native raw TX already rejects fragmented MPDUs. */
-	hw->wiphy->frag_threshold = sm_hw_tx_ccmp && sm_hw_tx_ccmp_fast ?
+	hw->wiphy->frag_threshold = !sm_legacy_tkip && sm_hw_tx_ccmp && sm_hw_tx_ccmp_fast ?
 		(u32)-1 : IEEE80211_MAX_FRAG_THRESHOLD;
 	hw->wiphy->rts_threshold = IEEE80211_MAX_RTS_THRESHOLD;
 	ieee80211_hw_set(hw, SIGNAL_DBM);
@@ -2469,8 +2485,15 @@ int s31_radio_wifi_frontend_init(struct device *parent)
 
 	{
 		static const u32 ciphers[] = { WLAN_CIPHER_SUITE_CCMP };
-		hw->wiphy->cipher_suites = ciphers;
-		hw->wiphy->n_cipher_suites = ARRAY_SIZE(ciphers);
+		static const u32 legacy_ciphers[] = {
+			WLAN_CIPHER_SUITE_CCMP, WLAN_CIPHER_SUITE_TKIP,
+		};
+
+		hw->wiphy->cipher_suites = sm_legacy_tkip ? legacy_ciphers : ciphers;
+		hw->wiphy->n_cipher_suites = sm_legacy_tkip ?
+			ARRAY_SIZE(legacy_ciphers) : ARRAY_SIZE(ciphers);
+		if (sm_legacy_tkip)
+			pr_warn("esp32s31-softmac: experimental legacy TKIP, all crypto in software\n");
 	}
 	SET_IEEE80211_DEV(hw, parent);
 
-- 
2.43.0


From 65ae6d60897bd36abca0dc09ecba560a3759a9f7 Mon Sep 17 00:00:00 2001
From: Glauber Franco <gnfranco@gmail.com>
Date: Wed, 25 Nov 2026 18:23:27 -0300
Subject: [PATCH 2/2] wifi: retain HT negotiation in experimental software
 crypto mode

Keep HE and native TX HT/aggregation disabled in the legacy experiment; let mac80211 constrain pairwise TKIP to legacy. WPA2-PSK CCMP pairwise/TKIP group, DHCP and gateway ping 5/5 validated on hardware. No pure TKIP pairwise or default CCMP regression claim. Developed with assistance from ChatGPT.

Signed-off-by: Glauber Franco <gnfranco@gmail.com>
---
 .../net/wireless/espressif/esp32s31_softmac.c | 39 +++++++++++++++++--
 1 file changed, 35 insertions(+), 4 deletions(-)

diff --git a/drivers/net/wireless/espressif/esp32s31_softmac.c b/drivers/net/wireless/espressif/esp32s31_softmac.c
index 678ef38d3..32cdf5463 100644
--- a/drivers/net/wireless/espressif/esp32s31_softmac.c
+++ b/drivers/net/wireless/espressif/esp32s31_softmac.c
@@ -73,7 +73,7 @@ static const bool sm_rx_ba = true;
  * Read-only parameter so crypto ownership cannot change while running. */
 static bool sm_legacy_tkip;
 module_param_named(legacy_tkip, sm_legacy_tkip, bool, 0400);
-MODULE_PARM_DESC(legacy_tkip, "experimental TKIP/CCMP software crypto, legacy rates only");
+MODULE_PARM_DESC(legacy_tkip, "experimental TKIP/CCMP software crypto; no native TX aggregation");
 
 static const bool sm_hw_ccmp = true;
 
@@ -1484,7 +1484,7 @@ static int sm_start(struct ieee80211_hw *hw)
 	memcpy(ctl.mac, hw->wiphy->perm_addr, ETH_ALEN);
 	ctl.channel = sm->channel ?: 1;
 	ctl.offset = ++sm->epoch;
-	ctl.field = (!sm_legacy_tkip && sm_ht ? 1 : 0) | (!sm_legacy_tkip && sm_ht && sm_he ? 2 : 0) |
+	ctl.field = (sm_ht ? 1 : 0) | (!sm_legacy_tkip && sm_ht && sm_he ? 2 : 0) |
 		(sm_rx_view ? S31_SOFTMAC_START_RX_VIEW : 0) |
 		(sm_rx_filter && sm_native_rx_filter ? S31_SOFTMAC_START_RX_RA_FILTER : 0) |
   (sm_native_rx_error_filter ? S31_SOFTMAC_START_RX_DROP_ERRORS : 0) |
@@ -1599,6 +1599,35 @@ static void sm_stop(struct ieee80211_hw *hw, bool suspend)
 		sm_rx_mark_ready(sm, i, skb);
 	}
 }
+static void sm_trace_assoc(struct sk_buff *skb, int tx_rate)
+{
+	struct ieee80211_hdr *hdr = (void *)skb->data;
+	u8 ie[2], rates[32];
+	unsigned int off, count = 0;
+	bool ht = false;
+
+	if (ieee80211_is_assoc_req(hdr->frame_control))
+		off = 28;
+	else if (ieee80211_is_reassoc_req(hdr->frame_control))
+		off = 34;
+	else
+		return;
+	while (off + 2 <= skb->len && !skb_copy_bits(skb, off, ie, 2)) {
+		off += 2;
+		if (ie[1] > skb->len - off)
+			break;
+		if (ie[0] == WLAN_EID_HT_CAPABILITY)
+			ht = true;
+		if ((ie[0] == WLAN_EID_SUPP_RATES || ie[0] == WLAN_EID_EXT_SUPP_RATES) &&
+		    ie[1] <= sizeof(rates) - count &&
+		    !skb_copy_bits(skb, off, rates + count, ie[1]))
+			count += ie[1];
+		off += ie[1];
+	}
+	pr_info("esp32s31-softmac: legacy assoc TX rate_idx=%d HT=%u rates=%*ph\n",
+		tx_rate, ht, (int)count, rates);
+}
+
 static void __aligned(64) sm_tx_inner(struct ieee80211_hw *hw, struct ieee80211_tx_control *ctl,
 		  struct sk_buff *skb)
 {
@@ -1635,6 +1664,8 @@ static void __aligned(64) sm_tx_inner(struct ieee80211_hw *hw, struct ieee80211_
 		sm_status(sm, skb, false, 1, 0);
 		return;
 	}
+	if (sm_legacy_tkip)
+		sm_trace_assoc(skb, txinfo->control.rates[0].idx);
 	spin_lock_irqsave(&sm->lock, flags);
 	if (sm_tx_ampdu && sm->associated && sm->tx_ht_peer && ctl->sta &&
 	    ctl->sta->wme && !sm->tx_ba_requested &&
@@ -2418,7 +2449,7 @@ int s31_radio_wifi_frontend_init(struct device *parent)
 	sm->band.n_channels = ARRAY_SIZE(sm->channels);
 	sm->band.bitrates = sm->rates;
 	sm->band.n_bitrates = ARRAY_SIZE(sm->rates);
-	if (!sm_legacy_tkip) {
+	{
 		sm->band.ht_cap.ht_supported = true;
 		sm->band.ht_cap.cap = IEEE80211_HT_CAP_SGI_20;
 		sm->band.ht_cap.ampdu_factor = IEEE80211_HT_MAX_AMPDU_64K;
@@ -2432,7 +2463,7 @@ int s31_radio_wifi_frontend_init(struct device *parent)
 		 * Outstanding gate <=8, and operational callback rejects windows
 		 * smaller than that gate to bound losses/retries within the window. */
 		hw->max_tx_aggregation_subframes = sm_tx_ampdu ? 64 : 1;
-		{
+		if (!sm_legacy_tkip) {
 			ieee80211_hw_set(hw, SUPPORT_FAST_XMIT);
 			/* Finish Internet checksums at the final private SRAM copy,
 			 * before native publication/CCMP. Avoid a second PSRAM payload pass. */
-- 
