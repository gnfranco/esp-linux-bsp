From 7a4e7f765263add79f87007cd5e118eaba154d9b Mon Sep 17 00:00:00 2001
From: Glauber Franco <776952+gnfranco@users.noreply.github.com>
Date: Thu, 26 Nov 2026 14:25:41 -0300
Subject: [PATCH 5/9] clk: reset: esp32s31: expose TWAI peripheral resources

Signed-off-by: Glauber Franco <776952+gnfranco@users.noreply.github.com>
---
 drivers/clk/clk-esp32s31.c     | 36 ++++++++++++++++++++++++++++++++++
 drivers/reset/reset-esp32s31.c | 10 ++++++++++
 2 files changed, 46 insertions(+)

diff --git a/drivers/clk/clk-esp32s31.c b/drivers/clk/clk-esp32s31.c
index 0e4187d6e..1df3a9c8a 100644
--- a/drivers/clk/clk-esp32s31.c
+++ b/drivers/clk/clk-esp32s31.c
@@ -25,6 +25,8 @@
 #define ESP32S31_HP_CLKRST_EMAC_CTRL0	0x0c8
 #define ESP32S31_HP_CLKRST_I2C0_CTRL0	0x0dc
 #define ESP32S31_HP_CLKRST_I2C1_CTRL0	0x0e0
+#define ESP32S31_HP_CLKRST_TWAI0_CTRL0	0x10c
+#define ESP32S31_HP_CLKRST_TWAI1_CTRL0	0x110
 #define ESP32S31_HP_CLKRST_IOMUX_CTRL0	0x15c
 #define ESP32S31_HP_CLKRST_PCNT_CTRL0	0x138
 #define ESP32S31_HP_CLKRST_SDIO_HOST_CTRL0	0x0c0
@@ -428,6 +430,8 @@ static const u16 esp32s31_i2c_parent_ids[] = {
 
 static const char * const esp32s31_rmt_parents[] = { "xtal" };
 
+static const char * const esp32s31_twai_parents[] = { "xtal" };
+
 static const struct esp_clk_desc esp32s31_clk_descs[] = {
 	[ESP_S31_CLK_IOMUX_APB] = {
 		.name = "iomux_apb",
@@ -560,6 +564,38 @@ static const struct esp_clk_desc esp32s31_clk_descs[] = {
 		.parents = esp32s31_rmt_parents,
 		.num_parents = ARRAY_SIZE(esp32s31_rmt_parents),
 	},
+	[ESP_S31_CLK_TWAI0_APB] = {
+		.name = "twai0_apb",
+		.reg = ESP32S31_HP_CLKRST_TWAI0_CTRL0,
+		.gate = BIT(0),
+		.parent_ids = esp32s31_apb_parent_ids,
+		.num_parents = ARRAY_SIZE(esp32s31_apb_parent_ids),
+	},
+	[ESP_S31_CLK_TWAI0] = {
+		.name = "twai0",
+		.reg = ESP32S31_HP_CLKRST_TWAI0_CTRL0,
+		.gate = BIT(3),
+		/* Select the XTAL source (selector 0). */
+		.prepare_clear = GENMASK(2, 1),
+		.parents = esp32s31_twai_parents,
+		.num_parents = ARRAY_SIZE(esp32s31_twai_parents),
+	},
+	[ESP_S31_CLK_TWAI1_APB] = {
+		.name = "twai1_apb",
+		.reg = ESP32S31_HP_CLKRST_TWAI1_CTRL0,
+		.gate = BIT(0),
+		.parent_ids = esp32s31_apb_parent_ids,
+		.num_parents = ARRAY_SIZE(esp32s31_apb_parent_ids),
+	},
+	[ESP_S31_CLK_TWAI1] = {
+		.name = "twai1",
+		.reg = ESP32S31_HP_CLKRST_TWAI1_CTRL0,
+		.gate = BIT(3),
+		/* Select the XTAL source (selector 0). */
+		.prepare_clear = GENMASK(2, 1),
+		.parents = esp32s31_twai_parents,
+		.num_parents = ARRAY_SIZE(esp32s31_twai_parents),
+	},
 };
 
 static const struct clk_ops *esp_clk_pick_ops(const struct esp_clk_desc *desc)
diff --git a/drivers/reset/reset-esp32s31.c b/drivers/reset/reset-esp32s31.c
index dcc696600..fdd4ac482 100644
--- a/drivers/reset/reset-esp32s31.c
+++ b/drivers/reset/reset-esp32s31.c
@@ -20,6 +20,8 @@
 #define ESP32S31_HP_CLKRST_RMT_CTRL0	0x0bc
 #define ESP32S31_HP_CLKRST_I2C0_CTRL0	0x0dc
 #define ESP32S31_HP_CLKRST_I2C1_CTRL0	0x0e0
+#define ESP32S31_HP_CLKRST_TWAI0_CTRL0	0x10c
+#define ESP32S31_HP_CLKRST_TWAI1_CTRL0	0x110
 #define ESP32S31_HP_CLKRST_IOMUX_CTRL0	0x15c
 #define ESP32S31_HP_CLKRST_PCNT_CTRL0	0x138
 
@@ -94,6 +96,14 @@ static const struct esp_s31_rst_desc esp_s31_rst_descs[ESP_S31_RST_NUM] = {
 		.reg = ESP32S31_HP_CLKRST_RMT_CTRL0,
 		.mask = BIT(1),
 	},
+	[ESP_S31_RST_TWAI0] = {
+		.reg = ESP32S31_HP_CLKRST_TWAI0_CTRL0,
+		.mask = BIT(4),
+	},
+	[ESP_S31_RST_TWAI1] = {
+		.reg = ESP32S31_HP_CLKRST_TWAI1_CTRL0,
+		.mask = BIT(4),
+	},
 };
 
 struct esp_s31_reset {
-- 
2.43.0

