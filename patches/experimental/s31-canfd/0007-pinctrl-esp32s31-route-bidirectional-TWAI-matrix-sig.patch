From 8a396fd8b21a0ddff81295c9903705dff414f3b4 Mon Sep 17 00:00:00 2001
From: Glauber Franco <776952+gnfranco@users.noreply.github.com>
Date: Thu, 26 Nov 2026 14:25:42 -0300
Subject: [PATCH 7/9] pinctrl: esp32s31: route bidirectional TWAI matrix
 signals

Signed-off-by: Glauber Franco <776952+gnfranco@users.noreply.github.com>
---
 drivers/pinctrl/espressif/pinctrl-esp32s31.c | 4 ++++
 include/dt-bindings/pinctrl/esp32s31-iomux.h | 4 ++++
 2 files changed, 8 insertions(+)

diff --git a/drivers/pinctrl/espressif/pinctrl-esp32s31.c b/drivers/pinctrl/espressif/pinctrl-esp32s31.c
index e4c49cad9..2483bde12 100644
--- a/drivers/pinctrl/espressif/pinctrl-esp32s31.c
+++ b/drivers/pinctrl/espressif/pinctrl-esp32s31.c
@@ -246,6 +246,10 @@ static const struct esp_pin_function esp32s31_functions[] = {
 	[ESP_FUNC_S31_RMT_TX1_ID] = { GPIO_FUNC_GPIO, ESP_FUNC_NONE, RMT_SIG_OUT1_IDX },
 	[ESP_FUNC_S31_RMT_TX2_ID] = { GPIO_FUNC_GPIO, ESP_FUNC_NONE, RMT_SIG_OUT2_IDX },
 	[ESP_FUNC_S31_RMT_TX3_ID] = { GPIO_FUNC_GPIO, ESP_FUNC_NONE, RMT_SIG_OUT3_IDX },
+	[ESP_FUNC_S31_TWAI0_LOOPBACK_ID] = { GPIO_FUNC_GPIO, TWAI0_RX_IDX,
+					 TWAI0_TX_IDX },
+	[ESP_FUNC_S31_TWAI1_LOOPBACK_ID] = { GPIO_FUNC_GPIO, TWAI1_RX_IDX,
+					 TWAI1_TX_IDX },
 };
 
 static int esp_s31_matrix_set_in(struct esp_pinctrl *epctl, u32 gpio, u32 signal)
diff --git a/include/dt-bindings/pinctrl/esp32s31-iomux.h b/include/dt-bindings/pinctrl/esp32s31-iomux.h
index 2e066dc9a..c81c7fc34 100644
--- a/include/dt-bindings/pinctrl/esp32s31-iomux.h
+++ b/include/dt-bindings/pinctrl/esp32s31-iomux.h
@@ -599,4 +599,8 @@
 #define ESP_FUNC_S31_RMT_TX2_ID			42
 #define ESP_FUNC_S31_RMT_TX3_ID			43
 
+/* Bidirectional matrix paths for isolated single-node TWAI self-test. */
+#define ESP_FUNC_S31_TWAI0_LOOPBACK_ID		44
+#define ESP_FUNC_S31_TWAI1_LOOPBACK_ID		45
+
 #endif /* ESP32S31_IOMUX_H */
-- 
2.43.0

